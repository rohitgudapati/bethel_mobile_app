{
  "name": "bethel-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test lib-test-build/test/unit.test.js",
    "test:emulator": "tsc -p tsconfig.test.json && firebase emulators:exec --only firestore,auth --project demo-bethel \"node --test --test-concurrency=1 'lib-test-build/test/*.test.js'\"",
    "seed": "npm run build && node lib/tools/seed.js",
    "make-admin": "npm run build && node lib/tools/makeAdmin.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.10.0",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.0.0",
    "typescript": "^5.7.0"
  }
}
